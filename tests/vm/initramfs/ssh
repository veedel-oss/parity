#!/bin/sh
# Stand-in for ssh inside the Linux 3.2 test VM: runs the remote command on
# this machine. The protocol session (-M) runs as the unprivileged user
# "tester", like a login over ssh would, and like sshd relays stdin, stdout
# and stderr through pipes created by that user (collect mode opens them as
# that user). Other sessions run as root and use bin/sudo.
master=0
while [ $# -gt 0 ]; do
    case $1 in
        --) shift; break ;;
        -M) master=1 ;;
        -S | -o | -F) shift ;;
    esac
    shift
done
shift # the target
if [ $master = 1 ]; then
    exec su -s /bin/sh tester -c '
        d=$(mktemp -d) && mkfifo "$d/err" || exit 255
        cat "$d/err" >&2 &
        cat | '"$*"' 2>"$d/err" | cat
        wait
        rm -r "$d"'
fi
exec sh -c "$*"
